# Copy these settings to the environment used by API and scheduler.
# Self-hosted Evolution v2 / WHATSAPP-BAILEYS. No Meta Cloud API or paid LLM.
EVOLUTION_ENABLED=0
EVOLUTION_BASE_URL=http://host.docker.internal:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=ragmatch
EVOLUTION_WEBHOOK_SECRET=
# Connected business number: country code + area code + number, digits only.
EVOLUTION_BOT_PHONE=
# Daily digest from this hour in America/Sao_Paulo; only after user opt-in.
EVOLUTION_DIGEST_HOUR=9
# Only for deploy/docker-compose.evolution.yml; generate using token_hex(32).
EVOLUTION_DB_PASSWORD=
