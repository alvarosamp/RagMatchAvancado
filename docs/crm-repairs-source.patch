+import {describe,it,expect} from 'vitest';
+import {extractionGroups,extractionValue,readableExtraction} from './catalog-extractions';
+const spec=(name:string,value:any,page=1)=>({nome:name,valor_normalizado:value,fonte:{documento_sha256:'doc',pagina:page},validacao:'revisar_aplicabilidade'});
+const archive=(specs:any[],pages=2)=>({descricoes_lpu:['XFP, SMF'],datasheets:[{sha256:'doc',paginas_com_identificador:[{pagina:2}]}],transcricao_integral:[{documento_sha256:'doc',paginas:Array.from({length:pages},()=>({}))}],especificacoes_tecnicas:specs});
+describe('catalog extraction review',()=>{
+ it('preserves zero, negative limits and typical values without converting missing limits to zero',()=>{
+  expect(extractionValue({Min:0,Typ:'-',Max:-15,Unit:'dBm'})).toEqual({min:0,max:-15});
+  expect(readableExtraction({Min:3.14,Typ:3.3,Max:3.47})).toBe('Mín.: 3.14 · Típ.: 3.3 · Máx.: 3.47');
+ });
+ it('keeps full unrecognized columns and conditional variants',()=>{
+  const value={'Commercial / Industrial':'0 to +70 / -40 to +85'};
+  expect(extractionValue(value)).toEqual(value);
+ });
+ it('separates guide pages from the exact model page',()=>{
+  const groups=extractionGroups(archive([spec('accessory','Bluetooth',24),spec('description','XFP',2)],30));
+  expect(groups.map(g=>g.relevant)).toEqual([true,false]);
+  expect(groups[0].items[0].raw).toBe('XFP');
+ });
+ it('flags the real XFP versus SFP+ mismatch even in a short exact-identifier PDF',()=>{
+  const [group]=extractionGroups(archive([spec('description','SFP+, 1270nm Tx/1330nm Rx')]));
+  expect(group.relevant).toBe(true);expect(group.conflicts[0]).toContain('LPU XFP');expect(group.conflicts[0]).toContain('SFP+');
+ });
+ it('turns explicit features into useful attributes while preserving the original evidence',()=>{
+  const [group]=extractionGroups(archive([spec('caracteristica_textual','Digital Diagnostics Monitoring (DDM)'),spec('caracteristica_textual','<2.0W Power Dissipation'),spec('caracteristica_textual','1310 or 1270nm DFB Transmitter')]));
+  expect(group.items[0]).toMatchObject({name:'ddm',value:true,raw:'Digital Diagnostics Monitoring (DDM)'});
+  expect(group.items[1]).toMatchObject({name:'dissipacao_potencia',value:{operador:'<',valor:2},unit:'W'});
+  expect(group.items[2].value).toBe('1310 or 1270nm DFB Transmitter');
+ });
+ it('never infers relevance without an exact identifier or includes LPU as pending',()=>{
+  const a=archive([spec('rate',10),{...spec('lpu',10),validacao:'informado_na_lpu'}]);a.datasheets=[];
+  expect(extractionGroups(a)[0]).toMatchObject({relevant:false});expect(extractionGroups(a)[0].items).toHaveLength(1);
+ });
+});
