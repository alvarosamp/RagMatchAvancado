+/** Deterministic review proposals. Document scope never implies technical approval. */
+export const extractionText = (value: any): string => value == null ? '—' : typeof value === 'object' ? JSON.stringify(value) : String(value);
+const present = (value: any) => value != null && !['', '-', '—'].includes(String(value).trim());
+export function extractionValue(value: any) {
+  if (!value || typeof value !== 'object' || Array.isArray(value)) return value;
+  const range: Record<string, any> = {};
+  for (const [source, target] of [['Min','min'],['Typ','tipico'],['Max','max']]) {
+    if (present(value[source])) range[target] = value[source];
+  }
+  return Object.keys(range).length ? range : value;
+}
+export function readableExtraction(value: any): string {
+  if (!value || typeof value !== 'object' || Array.isArray(value)) return extractionText(value);
+  const range = extractionValue(value);
+  if (range !== value) return Object.entries(range).map(([key,v]) => `${({min:'Mín.',tipico:'Típ.',max:'Máx.'} as any)[key]}: ${extractionText(v)}`).join(' · ');
+  return Object.entries(value).map(([key,v]) => `${({min:'Mín.',tipico:'Típ.',max:'Máx.'} as any)[key] || key.replace(/\s+/g,' ')}: ${extractionText(v)}`).join(' · ');
+}
+function textualAttribute(text: string) {
+  if (/^Digital Diagnostics Monitoring \(DDM\)$/i.test(text)) return {name:'ddm',value:true};
+  const connector = text.match(/^([\w+-]+) Connector Type$/i);
+  if (connector) return {name:'conector',value:connector[1]};
+  const fiber = text.match(/^(SMF|MMF) Transmission Medium$/i);
+  if (fiber) return {name:'tipo_fibra',value:fiber[1].toUpperCase()};
+  const power = text.match(/^([<>≤≥]?)\s*(\d+(?:\.\d+)?)\s*W Power Dissipation$/i);
+  if (power) return {name:'dissipacao_potencia',value:{operador:power[1] || '=',valor:Number(power[2])},unit:'W'};
+  if (/^PIN Receiver$/i.test(text)) return {name:'tipo_receptor',value:'PIN'};
+  return null;
+}
+export function extractionGroups(archive: any) {
+  const specs = Array.isArray(archive?.especificacoes_tecnicas) ? archive.especificacoes_tecnicas : [];
+  const docs = Array.isArray(archive?.datasheets) ? archive.datasheets : [];
+  const transcripts = Array.isArray(archive?.transcricao_integral) ? archive.transcricao_integral : [];
+  const groups = new Map<string, any>();
+  for (const spec of specs) {
+    if (!spec || spec.validacao === 'informado_na_lpu') continue;
+    const hash = spec.fonte?.documento_sha256 || 'sem-documento';
+    const doc = docs.find((d:any) => d.sha256 === hash);
+    const transcript = transcripts.find((d:any) => d.documento_sha256 === hash);
+    const exactPages = (doc?.paginas_com_identificador || []).map((p:any) => p.pagina);
+    // Only prioritize a short document with the exact identifier, never every page of a guide.
+    const specific = exactPages.length > 0 && transcript?.paginas?.length > 0 && transcript.paginas.length <= 4;
+    const relevant = specific || exactPages.includes(spec.fonte?.pagina);
+    const key = `${hash}:${relevant ? 'modelo' : 'geral'}`;
+    if (!groups.has(key)) groups.set(key, {key,hash,relevant,specific,source:doc?.origens?.find((s:any)=>s.url)?.url,items:[],conflicts:[]});
+    const name = spec.chave_padronizada || spec.nome || 'caracteristica_textual';
+    const raw = spec.valor_normalizado ?? spec.valor;
+    const parsed = /caracteristica[ _]textual/i.test(name) && typeof raw === 'string' ? textualAttribute(raw) : null;
+    const entry = {name:parsed?.name || name,value:parsed?.value ?? extractionValue(raw),unit:parsed?.unit || spec.unidade,raw,source:spec.fonte,condition:spec.condicao,original:spec};
+    const group = groups.get(key);
+    if (!group.items.some((old:any)=>old.name===entry.name && JSON.stringify(old.value)===JSON.stringify(entry.value) && old.source?.pagina===entry.source?.pagina)) group.items.push(entry);
+    if (name === 'description' && typeof raw === 'string') {
+      const lpu = (archive.descricoes_lpu || []).join(' ');
+      const form = (text:string) => text.match(/\b(QSFP28|QSFP\+|SFP28|SFP\+|XFP)\b|\b(QSFP\+|SFP\+)(?=[,\s]|$)/i)?.[0]?.toUpperCase();
+      const expected=form(lpu), observed=form(raw);
+      if (expected && observed && expected!==observed) group.conflicts.push(`Formato divergente: LPU ${expected}; descrição do documento ${observed}. Confira com o fabricante antes de usar os dados desta variante.`);
+    }
+  }
+  return [...groups.values()].sort((a,b)=>Number(b.relevant)-Number(a.relevant));
+}
+
