+ async function save(){if(!ready)return;setBusy(true);try{const c=data.candidatos.find((c:any)=>c.id===selected);const r=await crmFetch(base,{method:'PUT',body:JSON.stringify({state,base_revision:revision,catalog_product_id:selected||null,catalog_hash:c?.hash_catalogo,confirm:false})});if(!r.ok)throw Error(r.payload?.detail||'Não foi possível salvar.');setState(r.payload.state);setRevision(r.payload.base_revision);toast.success(r.payload.mensagem);onSaved(r.payload.mensagem);}catch(e:any){setError(e.message);}finally{setBusy(false);}}
+ if(!state)return <p className="p-4" role={error?'alert':undefined}>{error||'Abrindo item…'}</p>;
+ const fields=data?.campos||[];
