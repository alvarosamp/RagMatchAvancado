+ const names=Array.from(new Set([...ordered.filter((n:string)=>(data?.facetas?.[n]?.length||requirements.some((r:any)=>r.atributo===n)||n in state.catalog_filters)),...requirements.filter((r:any)=>r.atributo&&allowed.includes(r.atributo)).map((r:any)=>r.atributo)])) as string[];
