@@ -0,0 +1,154 @@
+// Extend this registry with aliases; additional BI leaves are discovered automatically.
+export const DIMENSIONS: Record<string, { label: string; aliases: string[] }> = {
+  category: { label: 'Categoria', aliases: [] },
+  brand: { label: 'Marca solicitada', aliases: ['marca', 'brand', 'fabricante', 'marca_referencia'] },
+  model: { label: 'Modelo solicitado', aliases: ['modelo', 'model', 'modelo_referencia', 'part_number'] },
+  reference: { label: 'Marca/modelo citado', aliases: ['marca_modelo'] },
+  ports: { label: 'Número de portas', aliases: ['quantidade_portas', 'portas_acesso_rj45_qtd', 'numero_portas'] },
+  speed: { label: 'Velocidade', aliases: ['velocidade', 'velocidade_nominal_gbps', 'velocidade_gbps', 'portas_acesso'] },
+  length: { label: 'Comprimento', aliases: ['comprimento', 'comprimento_m', 'length'] },
+  connector: { label: 'Conector / formato', aliases: ['conector', 'conectores', 'formato', 'form_factor'] },
+  fiber: { label: 'Tipo de fibra', aliases: ['tipo_fibra', 'tipo_meio'] },
+};
+
+export function normalizeText(value: unknown): string {
+  return String(value ?? '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim().replace(/\s+/g, ' ');
+}
+
+export function documented(value: unknown): string {
+  if (typeof value !== 'string' && typeof value !== 'number') return '';
+  const text = String(value).trim();
+  return /^(n\/?c|nao (identificado|informado|consta)|nenhum|null|undefined|-|)$/i.test(normalizeText(text)) ? '' : text;
+}
+
+export function featureLeaves(value: unknown, prefix = ''): Record<string, string> {
+  if (!value || typeof value !== 'object' || Array.isArray(value)) return {};
+  return Object.fromEntries(Object.entries(value).flatMap(([key, child]) => {
+    const path = prefix ? `${prefix}.${key}` : key;
+    if (child && typeof child === 'object' && !Array.isArray(child)) return Object.entries(featureLeaves(child, path));
+    const text = Array.isArray(child) ? child.map(documented).filter(Boolean).join(' / ') : documented(child);
+    return text ? [[path, text]] : [];
+  }));
+}
+
+export function canonicalCategory(value: unknown, description = ''): string {
+  const category = documented(value);
+  const text = normalizeText(!category || /^(outros?|cabos?|cabeamento)$/i.test(normalizeText(category)) ? description : category);
+  if (/\b(dac|direct attach|twinax)\b/.test(text)) return 'Cabo DAC';
+  if (/\b(aoc|active optical cable)\b/.test(text)) return 'Cabo óptico AOC';
+  if (/cabo.*(optic|otic|fibra)|cordao.*(optic|otic)|patch cord.*(optic|fibra)/.test(text)) return 'Cabo óptico';
+  return category || 'Sem categoria';
+}
+
+export type MarketItem = {
+  noticeId: string; category: string; state: string; portal: string; quantity: number; totalValue: number;
+  features: Record<string, string>; product: any; notice: any;
+};
+
+const finite = (value: unknown) => Number.isFinite(Number(value)) ? Math.max(0, Number(value)) : 0;
+
+export function marketItems(notices: any[]): MarketItem[] {
+  return notices.flatMap(notice => (Array.isArray(notice.notice_products) ? notice.notice_products : []).map((product: any) => {
+    const raw = product.raw_payload || {};
+    const leaves = { ...featureLeaves(raw.caracteristicas_bi), ...featureLeaves(product.bi_features) };
+    const features: Record<string, string> = {};
+    for (const [dimension, definition] of Object.entries(DIMENSIONS)) {
+      if (dimension === 'category') continue;
+      for (const alias of definition.aliases) {
+        const value = documented(raw[alias]) || documented(leaves[alias]) || Object.entries(leaves).find(([path]) => path.split('.').slice(-1)[0] === alias)?.[1] || documented(product[`bi_feature_${alias}`]);
+        if (value) {
+          features[dimension] = value;
+          if (dimension === 'speed' && /gbps$/.test(alias) && /^\d+(?:[.,]\d+)?$/.test(value)) features[dimension] = `${value}G`;
+          if (dimension === 'length' && /_m$/.test(alias) && /^\d+(?:[.,]\d+)?$/.test(value)) features[dimension] = `${value}m`;
+          break;
+        }
+      }
+    }
+    // Explicit labels only: catalog matches and winning brands are not requested brands.
+    const description = String(product.description || '');
+    const direction = raw.direcionamento_marca;
+    features.reference = features.reference || documented(product.brand_direction_model)
+      || (typeof direction === 'object' && direction ? documented(direction.marca_modelo) : documented(String(direction || '').match(/marca\/modelo\s*:\s*([^|]+)/i)?.[1]));
+    if (!features.reference) delete features.reference;
+    const directionType = product.brand_direction_type || (typeof direction === 'object' && direction ? direction.tipo : String(direction || '').match(/tipo\s*:\s*([^|]+)/i)?.[1]);
+    if (!features.brand && normalizeText(directionType) === 'marca' && features.reference) features.brand = features.reference;
+    for (const [dimension, label] of [['brand', 'marca|fabricante'], ['model', 'modelo']] as const) {
+      const match = description.match(new RegExp(`(?:^|[;\\n|]|\\b)(${label})\\s*:\\s*([^;\\n|]+)`, 'i'));
+      if (!features[dimension] && match) features[dimension] = documented(match[2]);
+    }
+    if (features.ports) features.ports = features.ports.replace(/\s*portas?$/i, '').trim();
+    const category = canonicalCategory(product.category || raw.categoria, description);
+    if (!features.ports && /switch/i.test(category)) {
+      const ports = description.match(/\b(\d+)\s+portas?\b/i);
+      if (ports) features.ports = ports[1];
+    }
+    for (const [path, value] of Object.entries(leaves)) {
+      if (!Object.values(DIMENSIONS).some(def => def.aliases.includes(path.split('.').slice(-1)[0]!))) features[`bi:${path}`] = value;
+    }
+    const quantity = finite(product.quantity);
+    return { noticeId: String(notice.id), category,
+      state: String(notice.state || notice.organs?.state || '').toUpperCase(), portal: notice.portals?.name || '',
+      quantity, totalValue: product.reference_total_price != null ? finite(product.reference_total_price) : finite(product.reference_price) * quantity,
+      features, product, notice };
+  }));
+}
+
+export type DemandRow = { key: string; label: string; quantity: number; items: number; notices: number; totalValue: number; share: number };
+
+export function rankDemand(items: MarketItem[], dimension: string, metric: 'quantity' | 'items' | 'notices' | 'totalValue' = 'quantity'): DemandRow[] {
+  const groups = new Map<string, DemandRow & { ids: Set<string> }>();
+  for (const item of items) {
+    const label = dimension === 'category' ? item.category : item.features[dimension];
+    if (!label) continue;
+    // Models are scoped to brand so unrelated model names never merge.
+    const display = dimension === 'model' ? `${item.features.brand || 'Marca N/C'} · ${label}` : label;
+    const key = normalizeText(display);
+    const row = groups.get(key) || { key, label: display, quantity: 0, items: 0, notices: 0, totalValue: 0, share: 0, ids: new Set<string>() };
+    row.quantity += item.quantity; row.items++; row.totalValue += item.totalValue; row.ids.add(item.noticeId);
+    groups.set(key, row);
+  }
+  const rows = [...groups.values()].map(({ ids, ...row }) => ({ ...row, notices: ids.size }));
+  // Shares use the same metric and include undocumented items in the denominator.
+  const denominator = metric === 'notices' ? new Set(items.map(item => item.noticeId)).size
+    : metric === 'items' ? items.length : items.reduce((sum, item) => sum + item[metric], 0);
+  return rows.map(row => ({ ...row, share: denominator ? row[metric] / denominator * 100 : 0 }))
+    .sort((a, b) => b[metric] - a[metric] || a.label.localeCompare(b.label, 'pt-BR'));
+}
+
+export function demandCsv(rows: DemandRow[]): string {
+  const cell = (value: unknown) => `"${String(value).replace(/^[=+@\-\t\r]/, "'$&").replace(/"/g, '""')}"`;
+  return '\uFEFF' + [['Valor', 'Unidades', 'Itens', 'Editais', 'Valor estimado', 'Participação (%)'], ...rows.map(row => [row.label, row.quantity, row.items, row.notices, row.totalValue, row.share.toFixed(2)])].map(row => row.map(cell).join(';')).join('\r\n');
+}
+
+/** Export the complete tenant dataset, independently of the visible filters. */
+export function marketExport(notices: any[], filters: Record<string, unknown> = {}) {
+  const items = marketItems(notices);
+  const dimensions = [...new Set([...Object.keys(DIMENSIONS), ...items.flatMap(item => Object.keys(item.features))])];
+  const metrics = ['quantity', 'items', 'notices', 'totalValue'] as const;
+  return {
+    schema_version: 1,
+    generated_at: new Date().toISOString(),
+    scope: 'Todos os editais disponíveis no CRM desta empresa, inclusive descartados; independente dos filtros da tela.',
+    limitations: ['Inclui dados retornados pelo CRM e atributos extraídos. Não inclui o conteúdo binário dos documentos nem dados ainda não importados da ConLicitação.'],
+    active_filters: filters,
+    summary: {
+      notices: notices.length, items: items.length,
+      quantities: items.reduce((sum, item) => sum + item.quantity, 0),
+      estimated_value: items.reduce((sum, item) => sum + item.totalValue, 0),
+      notices_without_items: notices.filter(notice => !notice.notice_products?.length).map(notice => notice.id),
+    },
+    dimensions: Object.fromEntries(dimensions.map(key => [key, {
+      label: DIMENSIONS[key]?.label || key.slice(3),
+      documented_items: items.filter(item => key === 'category' || item.features[key]).length,
+      rankings: Object.fromEntries(metrics.map(metric => [metric, rankDemand(items, key, metric)])),
+    }])),
+    normalized_items: items.map(({ notice, product, ...item }) => ({ ...item, product_id: product.id })),
+    notices,
+  };
+}
+
+export function marketExportJson(notices: any[], filters: Record<string, unknown> = {}) {
+  return JSON.stringify(marketExport(notices, filters), (key, value) =>
+    /^(authorization|password|token|access_token|refresh_token|api_key|secret|secret_key)$/i.test(key)
+      ? '[REDACTED]' : value, 2);
+}

diff --git a/src/lib/market-intelligence.test.ts b/src/lib/market-intelligence.test.ts
new file mode 100644
index 0000000..24bc011
--- /dev/null
+++ b/src/lib/market-intelligence.test.ts
@@ -0,0 +1,57 @@
+import { describe, expect, it } from 'vitest';
+import { canonicalCategory, marketItems, rankDemand, demandCsv, marketExportJson } from './market-intelligence';
+
+const notice = (id: string, products: any[]) => ({ id, state: 'SP', notice_products: products });
+
+describe('market intelligence', () => {
+  it('exports all notices, raw nested attributes and every ranking regardless of active filters', () => {
+    const data = [notice('1', [{ id: 'p1', quantity: 2, raw_payload: { marca: 'Acme', detalhes: { original: true }, token: 'secret' } }]), { id: '2', outcome: 'not_pursued', notice_products: [] }];
+    const exported = JSON.parse(marketExportJson(data, { state: 'RJ' }));
+    expect(exported.summary).toMatchObject({ notices: 2, items: 1, notices_without_items: ['2'] });
+    expect(exported.notices[0].notice_products[0].raw_payload.detalhes.original).toBe(true);
+    expect(exported.notices[0].notice_products[0].raw_payload.token).toBe('[REDACTED]');
+    expect(exported.dimensions.brand.rankings.quantity[0].quantity).toBe(2);
+    expect(exported.normalized_items[0].product_id).toBe('p1');
+    expect(exported.active_filters.state).toBe('RJ');
+  });
+  it('separates DAC, AOC, fiber cables and optical modules', () => {
+    expect(canonicalCategory('Cabo DAC SFP+')).toBe('Cabo DAC');
+    expect(canonicalCategory('Cabo AOC')).toBe('Cabo óptico AOC');
+    expect(canonicalCategory('Cabo de fibra óptica')).toBe('Cabo óptico');
+    expect(canonicalCategory('Transceiver')).toBe('Transceiver');
+    expect(canonicalCategory('Switch', 'switch com cabo DAC')).toBe('Switch');
+    expect(canonicalCategory('Outros', 'Cabo DAC SFP+')).toBe('Cabo DAC');
+  });
+  it('reads explicit requested attributes and retains extensible nested features', () => {
+    const [item] = marketItems([notice('1', [{ category: 'Switch', quantity: 3, raw_payload: { marca: 'Acme', modelo: 'X24' }, bi_features: { switch: { interfaces: { portas_acesso_rj45_qtd: '24' }, comercial: { garantia_meses: 60 } } } }])]);
+    expect(item.features).toMatchObject({ brand: 'Acme', model: 'X24', ports: '24', 'bi:switch.comercial.garantia_meses': '60' });
+  });
+  it('counts each notice once, keeps unknown quantity zero, and includes missing brands in share', () => {
+    const items = marketItems([notice('1', [{ quantity: 10, raw_payload: { marca: 'Acme' } }, { quantity: null, raw_payload: { marca: 'ACME' } }]), notice('2', [{ quantity: 5, raw_payload: { marca: 'N/C' } }])]);
+    expect(rankDemand(items, 'brand')[0]).toMatchObject({ quantity: 10, items: 2, notices: 1 });
+    expect(rankDemand(items, 'brand')[0].share).toBeCloseTo(66.6667);
+    expect(rankDemand(items, 'brand', 'notices')[0].share).toBe(50);
+  });
+  it('does not turn catalog matches, winning brands or combined references into requested brands', () => {
+    const [item] = marketItems([notice('1', [{ catalog_products: { brand: 'Suggestion' }, winner_brand: 'Winner', brand_direction_model: 'Acme X10', raw_payload: {} }])]);
+    expect(item.features.brand).toBeUndefined();
+    expect(item.features.reference).toBe('Acme X10');
+  });
+  it('scopes models by brand and sorts by the selected metric', () => {
+    const items = marketItems([notice('1', [{ quantity: 100, raw_payload: { marca: 'A', modelo: 'X' }, reference_total_price: 0 }]), notice('2', [{ quantity: 2, raw_payload: { marca: 'B', modelo: 'X' }, reference_total_price: 500 }])]);
+    expect(rankDemand(items, 'model')).toHaveLength(2);
+    expect(rankDemand(items, 'model', 'totalValue')[0].label).toBe('B · X');
+  });
+  it('accepts a legacy reference explicitly classified as brand', () => {
+    const [item] = marketItems([notice('1', [{ brand_direction_type: 'Marca', brand_direction_model: 'Acme' }])]);
+    expect(item.features.brand).toBe('Acme');
+  });
+  it('normalizes cable units and extracts only explicit description fields', () => {
+    const [item] = marketItems([notice('1', [{ category: 'Cabo DAC', description: 'Marca: Acme; Modelo: DAC10', bi_features: { cabo_dac: { comprimento_m: 3, velocidade_gbps: 10 } } }])]);
+    expect(item.features).toMatchObject({ brand: 'Acme', model: 'DAC10', length: '3m', speed: '10G' });
+  });
+  it('escapes CSV labels and neutralizes spreadsheet formulas', () => {
+    const items = marketItems([notice('1', [{ raw_payload: { marca: '=HYPERLINK("bad")' } }])]);
+    expect(demandCsv(rankDemand(items, 'brand'))).toContain('"\'=HYPERLINK(""bad"")"');
+  });
+});

