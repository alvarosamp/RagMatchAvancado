+import MarketIntelligence from './MarketIntelligence';
+
+vi.mock('@/integrations/supabase/client', () => ({ supabase: { from: () => ({ select: () => ({ neq: () => ({ order: async () => ({ data: [
+  { id: '1', created_at: '2026-10-01', state: 'SP', notice_products: [{ category: 'Switch', quantity: 10, raw_payload: { marca: 'Acme', modelo: 'X24' }, bi_features: { quantidade_portas: '24 Portas' } }] },
+  { id: '2', created_at: '2026-09-01', state: 'RJ', notice_products: [{ category: 'Cabo DAC', quantity: 4, raw_payload: { marca: 'CableCo', modelo: 'DAC3' } }] },
+], error: null }) }) }) }) } }));
+vi.mock('sonner', () => ({ toast: { error: vi.fn() } }));
+afterEach(cleanup);
+
+describe('market dashboard filters', () => {
+  it('uses the same filtered items in KPIs, coverage and brand rankings', async () => {
+    render(<MarketIntelligence />);
+    await waitFor(() => expect(screen.getByRole('option', { name: 'Cabo DAC' })).toBeTruthy());
+    fireEvent.change(screen.getByLabelText('Agrupar por'), { target: { value: 'brand' } });
+    expect(screen.getAllByText('Acme').length).toBeGreaterThan(0);
+    expect(screen.getByText('CableCo')).toBeTruthy();
+    fireEvent.change(screen.getByLabelText('UF'), { target: { value: 'RJ' } });
+    expect(screen.queryByText('Acme')).toBeNull();
+    expect(screen.getByText(/Cobertura: 1 de 1 itens/)).toBeTruthy();
+    expect(screen.getByText(/Líder do recorte: CableCo/)).toBeTruthy();
+  });
+  it('filters by registration date and opens the printable report', async () => {
+    const print = vi.spyOn(window, 'print').mockImplementation(() => {});
+    render(<MarketIntelligence />);
+    await waitFor(() => expect(screen.getByRole('option', { name: 'Cabo DAC' })).toBeTruthy());
+    fireEvent.change(screen.getByLabelText('Cadastro desde'), { target: { value: '2026-10-01' } });
+    expect(screen.queryByText('CableCo')).toBeNull();
+    expect(screen.getByText(/Cobertura: 1 de 1 itens/)).toBeTruthy();
+    fireEvent.click(screen.getByRole('button', { name: 'Relatório / PDF' }));
+    expect(print).toHaveBeenCalledOnce();
+    print.mockRestore();
+  });
+});
