@@ -0,0 +1,80 @@
+import { useState } from 'react';
+import { Link } from 'react-router-dom';
+import { useAuth } from '@/hooks/useAuth';
+import { crmFetch } from '@/integrations/supabase/client';
+import { useLpuStatus, refreshLpu, lpuDate, LpuStatus } from '@/lib/lpu-lifecycle';
+import { Button } from '@/components/ui/button';
+import { Input } from '@/components/ui/input';
+import { Card, CardContent } from '@/components/ui/card';
+import { toast } from 'sonner';
+
+export function LpuAlerts() {
+  const { status, error } = useLpuStatus();
+  if (error) return <div role="alert" className="m-4 text-sm text-destructive">{error}</div>;
+  if (!status || (!status.expired && !status.pending.length)) return null;
+  const assigned = status.pending.filter(p => p.assigned_to_me).length;
+  return <div role="alert" className="m-4 rounded-lg border border-destructive/40 bg-destructive/10 p-4 text-sm space-y-2">
+    {status.expired && <p><strong>LPU invalida:</strong> validade encerrada em {lpuDate(status.current!.valid_until)}. Os dados continuam preservados.</p>}
+    {status.pending.length > 0 && <p>{status.pending.length} produto(s) ausente(s) da nova LPU aguardando revisao. {assigned > 0 && `${assigned} atribuido(s) a voce.`}</p>}
+    <Link className="font-semibold underline" to="/produtos">Conferir LPU e pendencias no catalogo</Link>
+  </div>;
+}
+
+export function LpuOwnerSelect({ users, value, onChange, disabled = false }: { disabled?: boolean; users: LpuStatus['users']; value: string; onChange: (value: string) => void }) {
+  return <label className="block text-sm space-y-1">Usuario responsavel
+    <select disabled={disabled} aria-label="Usuario responsavel" className="w-full rounded-md border bg-background px-3 py-2" value={value} onChange={e => onChange(e.target.value)}>
+      <option value="">Selecione um usuario</option>
+      {users.map(u => <option key={u.id} value={u.id}>{u.name}</option>)}
+    </select>
+  </label>;
+}
+
+export function LpuManagement({ onChanged }: { onChanged: () => void }) {
+  const { status, error } = useLpuStatus();
+  const { isAdmin } = useAuth();
+  const [extending, setExtending] = useState(false);
+  const [deadline, setDeadline] = useState('');
+  const [owner, setOwner] = useState('');
+  const [reviewing, setReviewing] = useState<string | null>(null);
+  const [busy, setBusy] = useState(false);
+  async function mutate(path: string, payload: object) {
+    setBusy(true);
+    try {
+      const result = await crmFetch(path, { method: 'POST', body: JSON.stringify(payload) });
+      if (!result.ok) throw new Error(result.payload?.detail || 'Nao foi possivel salvar.');
+      refreshLpu(); onChanged(); setExtending(false); setReviewing(null);
+      toast.success('Alteracao salva. Dados dos processos preservados.');
+    } catch (e) { toast.error(e instanceof Error ? e.message : 'Falha ao salvar.'); }
+    finally { setBusy(false); }
+  }
+  if (error) return <p role="alert" className="text-destructive">{error}</p>;
+  if (!status) return null;
+  return <Card><CardContent className="p-4 space-y-4">
+    {status.current ? <div className="space-y-2">
+      <p className="font-semibold">LPU {status.expired ? 'invalida' : 'vigente'} — validade: {lpuDate(status.current.valid_until)}</p>
+      <p className="text-sm">Responsavel: {status.users.find(u => u.id === Number(status.current!.owner_id))?.name || 'Usuario indisponivel'}</p>
+      {isAdmin && <Button variant="outline" onClick={() => { setExtending(!extending); setOwner(String(status.current!.owner_id)); }}>Aumentar validade</Button>}
+      {extending && <div className="grid gap-3 md:grid-cols-3 items-end">
+        <label className="text-sm">Nova validade<Input type="date" value={deadline} onChange={e => setDeadline(e.target.value)} /></label>
+        <LpuOwnerSelect users={status.users} value={owner} onChange={setOwner} />
+        <Button disabled={busy || !deadline || !owner} onClick={() => mutate(`/api/crm/lpu/${status.current!.id}/extend`, { valid_until: deadline, owner_id: Number(owner) })}>Salvar prorrogacao</Button>
+      </div>}
+    </div> : <p className="text-sm">A LPU anterior nao tem validade registrada. Informe a validade e o responsavel na proxima importacao.</p>}
+    {status.pending.length > 0 && <div className="space-y-3">
+      <p className="font-semibold">Produtos ausentes da nova LPU</p>
+      <p className="text-sm text-muted-foreground">Prazo de um mes para revisar. Vencer o prazo nao apaga os dados. Confirmar retira o produto do catalogo ativo e mantem seu historico nos processos.</p>
+      {status.pending.map(p => <div key={p.id} className="rounded-md border p-3 space-y-2">
+        <p>{p.name} — {p.sku}</p>
+        <p className="text-sm">Revisar ate {lpuDate(p.lpu_review_deadline)} {p.overdue && '— Prazo vencido'} · Responsavel: {status.users.find(u => u.id === Number(p.lpu_review_owner_id))?.name || 'Usuario indisponivel'}</p>
+        <Button size="sm" variant="outline" onClick={() => setReviewing(reviewing === p.id ? null : p.id)}>Conferir</Button>
+        {reviewing === p.id && <div className="space-y-2 text-sm">
+          <p>Custo: {p.cost?.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' })} · Minimo: {p.min_price?.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) ?? 'Nao informado'}</p>
+          {p.lpu_drive_url && <a className="block underline" href={p.lpu_drive_url} target="_blank" rel="noreferrer">Abrir LPU antiga</a>}
+          {(isAdmin || p.assigned_to_me) && <Button size="sm" variant="destructive" disabled={busy} onClick={() => {
+            if (window.confirm(`Confirmar a retirada de ${p.sku} do catalogo ativo? Precos, dados e referencia da LPU antiga serao preservados nos processos.`)) void mutate(`/api/crm/lpu/products/${p.id}/review`, { action: 'confirm' });
+          }}>Confirmar retirada do catalogo</Button>}
+        </div>}
+      </div>)}
+    </div>}
+  </CardContent></Card>;
+}
