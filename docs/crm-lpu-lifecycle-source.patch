+import { fireEvent, render, screen, waitFor } from '@testing-library/react';
+import { MemoryRouter } from 'react-router-dom';
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import { LpuAlerts, LpuManagement } from './LpuLifecycle';
+
+const mocks = vi.hoisted(() => ({
+  status: { current: { id: 'lpu-1', version: 'v1', valid_until: '2026-10-01', owner_id: 1, drive_url: 'https://drive.google.com/old' },
+    expired: true, users: [{ id: 1, name: 'Responsavel' }, { id: 2, name: 'Novo responsavel' }],
+    pending: [{ id: 'product-1', name: 'Switch antigo', sku: 'SW1', cost: 100, min_price: 120, lpu_review_deadline: '2026-11-14',
+      lpu_review_owner_id: 1, lpu_drive_url: 'https://drive.google.com/old', assigned_to_me: true, overdue: false }] },
+  fetch: vi.fn(), refresh: vi.fn(),
+}));
+vi.mock('@/lib/lpu-lifecycle', () => ({ useLpuStatus: () => ({ status: mocks.status, error: '' }), refreshLpu: mocks.refresh,
+  lpuDate: (date: string) => date.split('-').reverse().join('/') }));
+vi.mock('@/integrations/supabase/client', () => ({ crmFetch: mocks.fetch }));
+vi.mock('@/hooks/useAuth', () => ({ useAuth: () => ({ isAdmin: true }) }));
+vi.mock('sonner', () => ({ toast: { success: vi.fn(), error: vi.fn() } }));
+
+describe('LPU lifecycle controls', () => {
+  beforeEach(() => { vi.clearAllMocks(); mocks.fetch.mockResolvedValue({ ok: true, payload: {} }); });
+  it('shows expiry and assigned review on CRM entry', () => {
+    render(<MemoryRouter><LpuAlerts /></MemoryRouter>);
+    expect(screen.getByRole('alert')).toHaveTextContent('LPU invalida');
+    expect(screen.getByRole('alert')).toHaveTextContent('01/10/2026');
+    expect(screen.getByRole('alert')).toHaveTextContent('1 atribuido(s) a voce');
+    expect(screen.getByRole('link')).toHaveAttribute('href', '/produtos');
+  });
+  it('sends the selected owner together with the extended validity', async () => {
+    render(<LpuManagement onChanged={vi.fn()} />);
+    fireEvent.click(screen.getByText('Aumentar validade'));
+    fireEvent.change(screen.getByLabelText('Nova validade'), { target: { value: '2026-12-31' } });
+    fireEvent.change(screen.getByLabelText('Usuario responsavel'), { target: { value: '2' } });
+    fireEvent.click(screen.getByText('Salvar prorrogacao'));
+    await waitFor(() => expect(mocks.fetch).toHaveBeenCalledWith('/api/crm/lpu/lpu-1/extend', {
+      method: 'POST', body: JSON.stringify({ valid_until: '2026-12-31', owner_id: 2 }),
+    }));
+  });
+  it('lets the user inspect old prices and LPU before explicitly confirming removal', async () => {
+    const confirm = vi.spyOn(window, 'confirm').mockReturnValue(true);
+    render(<LpuManagement onChanged={vi.fn()} />);
+    expect(mocks.fetch).not.toHaveBeenCalled();
+    fireEvent.click(screen.getByText('Conferir'));
+    expect(screen.getByText(/Custo:/)).toHaveTextContent('100');
+    expect(screen.getByText('Abrir LPU antiga')).toHaveAttribute('href', 'https://drive.google.com/old');
+    fireEvent.click(screen.getByText('Confirmar retirada do catalogo'));
+    await waitFor(() => expect(mocks.fetch).toHaveBeenCalledWith('/api/crm/lpu/products/product-1/review', {
+      method: 'POST', body: JSON.stringify({ action: 'confirm' }),
+    }));
+    expect(confirm).toHaveBeenCalledOnce(); confirm.mockRestore();
+  });
+});
diff --git a/src/components/catalog/LpuLifecycle.tsx b/src/components/catalog/LpuLifecycle.tsx
