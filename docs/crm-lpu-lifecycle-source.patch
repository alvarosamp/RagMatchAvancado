new file mode 100644
index 0000000..7b471a1
--- /dev/null
+++ b/src/lib/lpu-lifecycle.ts
@@ -0,0 +1,32 @@
+import { useEffect, useState } from 'react';
+import { crmFetch } from '@/integrations/supabase/client';
+
+export type LpuStatus = {
+  current: { id: string; version: string; valid_until: string; owner_id: number; drive_url: string } | null;
+  expired: boolean;
+  pending: Array<{ id: string; name: string; sku: string; cost: number; min_price: number | null;
+    lpu_review_deadline: string; lpu_review_owner_id: number; lpu_drive_url: string;
+    assigned_to_me: boolean; overdue: boolean }>;
+  users: Array<{ id: number; name: string }>;
+};
+export const refreshLpu = () => window.dispatchEvent(new Event('lpu-changed'));
+export const lpuDate = (date: string) => date.split('-').reverse().join('/');
+export function useLpuStatus() {
+  const [status, setStatus] = useState<LpuStatus | null>(null);
+  const [error, setError] = useState('');
+  useEffect(() => {
+    let active = true;
+    const load = async () => {
+      try {
+        const response = await crmFetch('/api/crm/lpu/status');
+        if (!response.ok) throw new Error(response.payload?.detail || 'Nao foi possivel carregar os avisos da LPU.');
+        if (active) { setStatus(response.payload); setError(''); }
+      } catch (e) { if (active) setError(e instanceof Error ? e.message : 'Falha ao carregar LPU.'); }
+    };
+    void load();
+    const timer = window.setInterval(load, 60000);
+    window.addEventListener('lpu-changed', load);
+    return () => { active = false; clearInterval(timer); window.removeEventListener('lpu-changed', load); };
+  }, []);
+  return { status, error };
+}
