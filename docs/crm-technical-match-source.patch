diff --git a/src/components/notices/TechnicalMatchDetails.tsx b/src/components/notices/TechnicalMatchDetails.tsx
new file mode 100644
index 0000000..1010b72
--- /dev/null
+++ b/src/components/notices/TechnicalMatchDetails.tsx
@@ -0,0 +1,76 @@
+import { useEffect, useState } from 'react';
+import { crmFetch } from '@/integrations/supabase/client';
+import { Badge } from '@/components/ui/badge';
+
+function valueLabel(value: any): string {
+  if (value == null) return 'Não informado';
+  if (typeof value === 'object' && 'valor' in value) return valueLabel(value.valor) + (value.unidade ? ` ${value.unidade}` : '');
+  return typeof value === 'object' ? JSON.stringify(value) : String(value);
+}
+
+export function TechnicalMatchDetails({result, humanStatus}: {result: any; humanStatus: string}) {
+  if (!result) return null;
+  return <section className="space-y-3">
+    <div className="flex flex-wrap gap-2"><Badge variant="outline">Decisão técnica: {result.status}</Badge>
+      <Badge variant="secondary">Cobertura {Math.round(result.cobertura * 100)}%</Badge><Badge variant="outline">Seleção: {humanStatus}</Badge></div>
+    <div className="overflow-x-auto"><table className="w-full text-left text-sm"><thead><tr>
+      {['Requisito', 'Exigido', 'Produto', 'Decisão', 'Evidência / motivo'].map(label => <th key={label} className="p-2">{label}</th>)}
+    </tr></thead><tbody>{result.detalhes.map((row: any, index: number) => <tr key={index} className="border-t">
+      <td className="p-2">{row.id} {row.texto_original || row.atributo}{row.grupo_logico && <small className="block">Grupo {row.grupo_logico} ({row.operador_logico})</small>}</td>
+      <td className="p-2">{row.operador} {valueLabel(row.exigido)}{row.escopo && <small className="block">Condição: {valueLabel(row.escopo)}</small>}</td>
+      <td className="p-2">{valueLabel(row.encontrado)}</td><td className="p-2">{row.status}</td>
+      <td className="p-2">{row.motivo}{(row.fontes || []).flatMap((source: any) => source.valor?.evidencias || []).map((e: any, i: number) =>
+        <a key={i} className="block underline" href={`/api/crm/catalog-datasheets/${encodeURIComponent(e.documento_id)}/download#page=${e.pagina}`} target="_blank" rel="noreferrer">Documento v{e.versao_documento || '—'}, página {e.pagina}</a>)}
+      </td></tr>)}</tbody></table></div>
+    {(result.grupos || []).map((g: any) => <p key={g.atributo} className="text-xs">{g.atributo}: {g.status}</p>)}
+    <p className="text-xs text-muted-foreground">Regras {result.versao_regras} · Revisão {result.revisao_produto || '—'} · Variante {result.variante_produto || '—'}</p>
+  </section>;
+}
+
+export function ItemTechnicalFilters({noticeId, itemId, onChange}: {noticeId: string; itemId: string; onChange: (ids: string[] | null, filters: Record<string, any[]>) => void}) {
+  const [filters, setFilters] = useState<Record<string, any[]>>({});
+  const [data, setData] = useState<any>(null);
+  const [error, setError] = useState('');
+  useEffect(() => {
+    let live = true;
+    setError('');
+    crmFetch(`/api/crm/notices/${noticeId}/products/${itemId}/match-facets?filters=${encodeURIComponent(JSON.stringify(filters))}`)
+      .then(response => {
+        if (!live) return;
+        if (!response.ok) { setError(response.payload?.detail || 'Não foi possível carregar os filtros'); onChange(null, filters); return; }
+        setData(response.payload);
+        onChange(Object.values(filters).some(v => v.length) ? response.payload.catalog_product_ids : null, filters);
+      }).catch(() => { if (live) setError('Não foi possível carregar os filtros'); });
+    return () => { live = false; };
+    // onChange is a parent state setter closure, excluded to avoid re-fetch loops.
+  }, [noticeId, itemId, filters]);
+  if (error) return <p className="text-xs text-muted-foreground">{error}</p>;
+  if (!data) return <p className="text-xs">Carregando características…</p>;
+  return <div className="space-y-2"><p className="text-sm">Categoria {data.categoria || 'não informada'}: {data.filtered_total} de {data.total} produtos no catálogo</p>
+    <div className="flex flex-wrap gap-3">{Object.entries(data.facets).map(([name, options]: [string, any]) => <label key={name} className="text-xs">
+      {name}<select className="block rounded border bg-background p-2" value={filters[name]?.length ? JSON.stringify(filters[name][0]) : ''} onChange={e => setFilters(previous => ({...previous, [name]: e.target.value ? [JSON.parse(e.target.value)] : []}))}>
+        <option value="">Todos</option>{options.map((o: any) => <option key={JSON.stringify(o.value)} value={JSON.stringify(o.value)}>{valueLabel(o.value)} ({o.count})</option>)}
+      </select></label>)}</div>
+    <p className="text-xs text-muted-foreground">Os filtros selecionam produtos do catálogo; a decisão técnica está na matriz de cada candidato.</p>
+  </div>;
+}
+
+export function TechnicalHistory({matchId}:{matchId:string}) {
+  const [history,setHistory] = useState<any[] | null>(null);
+  const [error,setError] = useState('');
+  async function load() {
+    setError('');
+    try {
+      const response = await crmFetch(`/api/crm/matches/${matchId}/technical-history`);
+      if (!response.ok) throw new Error(response.payload?.detail || 'Não foi possível carregar o histórico');
+      setHistory(response.payload.history);
+    } catch(e:any) {setError(e.message)}
+  }
+  return <details onToggle={e=>{if(e.currentTarget.open && history===null) load()}}><summary className="cursor-pointer text-sm">Histórico de reavaliações</summary>
+    {error && <p role="alert">{error}</p>}
+    {history?.length===0 && <p className="text-xs">Nenhuma reavaliação registrada.</p>}
+    {history?.map((event:any,index:number)=><section key={index} className="mt-2 rounded border p-2"><p className="text-xs">{new Date(event.created_at).toLocaleString('pt-BR',{timeZone:'America/Sao_Paulo'})} · Revisor {event.user_id}</p>
+      <p className="text-sm">Decisão anterior: {event.previous_result?.status || 'Sem matriz'} → {event.technical_result?.status}</p>
+      {event.previous_result && <TechnicalMatchDetails result={event.previous_result} humanStatus={event.human_status}/>}</section>)}
+  </details>;
+}
