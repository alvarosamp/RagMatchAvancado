@@ -0,0 +1,79 @@
+import { useEffect, useState } from 'react';
+import { Button } from '@/components/ui/button';
+import { crmFetch } from '@/integrations/supabase/client';
+import { listCatalogDatasheets, CatalogDatasheet } from '@/lib/document-files';
+import { toast } from 'sonner';
+
+type Row = {name: string; value: string; unit: string; documentId: string; page: string; reviewed: boolean; fiber: string};
+const blank = (): Row => ({name:'', value:'', unit:'', documentId:'', page:'', reviewed:false, fiber:''});
+export function TechnicalSheetEditor({productId, category, specification, onSaved}: {productId:string; category:string; specification:string; onSaved:(value:string)=>void}) {
+  const [rows, setRows] = useState<Row[]>([blank()]);
+  const [documents, setDocuments] = useState<CatalogDatasheet[]>([]);
+  const [revision, setRevision] = useState('');
+  const [variant, setVariant] = useState('');
+  const [draftDocument, setDraftDocument] = useState('');
+  const [busy, setBusy] = useState(false);
+  useEffect(() => {
+    let live = true;
+    listCatalogDatasheets(productId).then(value => {if(live) setDocuments(value)}).catch(() => {if(live) setDocuments([])});
+    try {
+      const sheet = JSON.parse(specification);
+      if (sheet.atributos) {
+        setRevision(sheet.revisao || ''); setVariant(sheet.variante || '');
+        setRows(Object.entries(sheet.atributos).flatMap(([name, attribute]:[string, any]) => (attribute.variantes || [attribute]).map((value:any) => ({name, value:JSON.stringify(value?.valor ?? value), unit:value?.unidade || '', documentId:value?.evidencias?.[0]?.documento_id || '', page:String(value?.evidencias?.[0]?.pagina || ''), reviewed:value?.evidencias?.[0]?.revisado === true, fiber:value?.escopo?.tipo_fibra || ''}))));
+      }
+    } catch { setRows([blank()]); }
+    return () => {live = false};
+  }, [productId]);
+  function edit(index:number, patch:Partial<Row>) {setRows(previous => previous.map((row, i) => i === index ? {...row,...patch} : row))}
+  async function suggest() {
+    setBusy(true);
+    try {
+      const response = await crmFetch(`/api/crm/catalog-products/${productId}/technical-sheet/draft`, {method:'POST', body:JSON.stringify({documento_id:draftDocument})});
+      if (!response.ok) throw new Error(response.payload?.detail || 'Não foi possível extrair sugestões');
+      const added = Object.entries(response.payload.atributos).map(([name,value]:[string,any]) => ({name, value:JSON.stringify(value.valor), unit:value.unidade || '', documentId:draftDocument, page:String(value.evidencias[0].pagina), reviewed:false, fiber:''}));
+      setRows(previous => [...previous.filter(r=>r.name.trim()), ...added.filter(r=>!rows.some(old=>old.name===r.name))]);
+      toast.info(`${added.length} sugestões para revisão; ${response.payload.conflitos.length} conflitos no documento`);
+    } catch(e:any) {toast.error(e.message)} finally {setBusy(false)}
+  }
+  async function save() {
+    setBusy(true);
+    try {
+      const attributes: Record<string, any> = {};
+      for (const row of rows) {
+        if (!row.name.trim()) continue;
+        if (!row.value.trim()) throw new Error('Informe o valor de cada atributo');
+        let value; try {value=JSON.parse(row.value)} catch {value=row.value.trim()}
+        const entry = {valor:value, ...(row.fiber ? {escopo:{tipo_fibra:row.fiber}} : {}), ...(row.unit ? {unidade:row.unit} : {}), evidencias:row.documentId ? [{documento_id:row.documentId, pagina:Number(row.page), revisado:row.reviewed}] : []};
+        const key=row.name.trim();
+        if (!attributes[key]) attributes[key]=entry;
+        else {
+          const variants=attributes[key].variantes || [attributes[key]];
+          if (!row.fiber || variants.some((v:any)=>!v.escopo?.tipo_fibra || v.escopo.tipo_fibra===row.fiber)) throw new Error("Atributos repetidos exigem condições de fibra diferentes");
+          attributes[key]={variantes:[...variants,entry]};
+        }
+      }
+      const response = await crmFetch(`/api/crm/catalog-products/${productId}/technical-sheet`, {method:'PUT', body:JSON.stringify({categoria:category, revisao:revision, variante:variant, atributos:attributes})});
+      if (!response.ok) throw new Error(response.payload?.detail || 'Não foi possível salvar');
+      onSaved(JSON.stringify(response.payload.technical_sheet));
+      toast.success('Ficha técnica salva');
+    } catch(e:any) {toast.error(e.message)} finally {setBusy(false)}
+  }
+  return <section className="space-y-3 rounded border p-3"><h3 className="font-semibold">Ficha técnica documentada</h3>
+    <p className="text-xs text-muted-foreground">Informe números, textos, listas ou faixas como valores. Marque como revisado após conferir a página do datasheet.</p>
+    <div className="flex gap-2"><select aria-label="PDF para sugestões" className="max-w-[65%] rounded border bg-background p-2" value={draftDocument} onChange={e=>setDraftDocument(e.target.value)}><option value="">Selecionar PDF</option>{documents.filter(d=>d.original_filename.toLowerCase().endsWith('.pdf')).map(d=><option key={d.id} value={d.id}>v{d.version} — {d.original_filename}</option>)}</select><Button type="button" variant="outline" disabled={busy || !draftDocument} onClick={suggest}>Sugerir atributos do PDF</Button></div>
+    <div className="flex gap-2"><label className="text-xs">Revisão<input className="block w-full rounded border p-2" value={revision} onChange={e=>setRevision(e.target.value)}/></label><label className="text-xs">Variante<input className="block w-full rounded border p-2" value={variant} onChange={e=>setVariant(e.target.value)}/></label></div>
+    {rows.map((row,i)=><div key={i} className="grid gap-2 border-t pt-2 sm:grid-cols-2">
+      <input aria-label={`Atributo ${i+1}`} className="rounded border bg-background p-2" placeholder="poe_budget_w" value={row.name} onChange={e=>edit(i,{name:e.target.value})}/>
+      <input aria-label={`Valor ${i+1}`} className="rounded border bg-background p-2" placeholder='410 ou {"min":-10,"max":50}' value={row.value} onChange={e=>edit(i,{value:e.target.value})}/>
+      <input aria-label={`Unidade ${i+1}`} className="rounded border bg-background p-2" placeholder="Unidade (W, Gbps, m, nm, C)" value={row.unit} onChange={e=>edit(i,{unit:e.target.value})}/>
+      <select aria-label={`Documento ${i+1}`} className="rounded border bg-background p-2" value={row.documentId} onChange={e=>edit(i,{documentId:e.target.value})}><option value="">Sem evidência</option>{documents.map(d=><option key={d.id} value={d.id}>v{d.version} — {d.original_filename}</option>)}</select>
+      <label className="text-xs">Condição de fibra<select className="block rounded border bg-background p-2" value={row.fiber} onChange={e=>edit(i,{fiber:e.target.value})}><option value="">Sem condição</option>{['OM1','OM2','OM3','OM4','OM5','SMF','MMF'].map(f=><option key={f} value={f}>{f}</option>)}</select></label>
+      <input aria-label={`Página ${i+1}`} className="rounded border bg-background p-2" type="number" min={1} placeholder="Página" value={row.page} onChange={e=>edit(i,{page:e.target.value})}/>
+      <label className="text-sm"><input type="checkbox" checked={row.reviewed} onChange={e=>edit(i,{reviewed:e.target.checked})}/> Valor conferido no documento</label>
+      <Button type="button" variant="ghost" onClick={()=>setRows(previous=>previous.filter((_,j)=>j!==i))}>Remover atributo</Button>
+    </div>)}
+    <Button type="button" variant="outline" onClick={()=>setRows(previous=>[...previous,blank()])}>Adicionar atributo</Button>{' '}
+    <Button type="button" disabled={busy} onClick={save}>{busy?'Salvando…':'Salvar ficha revisada'}</Button>
+  </section>;
+}
