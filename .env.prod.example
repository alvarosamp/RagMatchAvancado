POSTGRES_DB=edital_matcher
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-por-senha-forte
SECRET_KEY=troque-por-chave-aleatoria-longa
# Tag imutavel publicada pelo CI, por exemplo sha-0123abcd. Nunca use latest em producao.
IMAGE_TAG=sha-substitua-pelo-commit-publicado
MINIO_ROOT_USER=ragmatch-storage
MINIO_ROOT_PASSWORD=troque-por-outra-senha-forte
S3_BUCKET=edital-matcher
ACCESS_TOKEN_EXPIRE_MINUTES=60
REGISTER_ENABLED=0
APP_ENV=production
# Roteamento Traefik usado pela VPS Hostinger.
APP_DOMAIN=ragmatch.srv1934808.hstgr.cloud
API_DOMAIN=api.ragmatch.srv1934808.hstgr.cloud
AUTH_COOKIE_NAME=access_token
AUTH_COOKIE_SECURE=1
AUTH_COOKIE_SAMESITE=lax
AUTH_TOKEN_IN_BODY=0
MAX_PDF_UPLOAD_BYTES=52428800
MAX_DOCUMENT_UPLOAD_BYTES=52428800
AI_FEATURES_ENABLED=1
DATASHEET_EXTRACTOR_USE_LLM=0
CRM_MATCH_USE_LLM=0
OLLAMA_MODEL=llama3.2:1b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Worker separado para inferencia. Comece com LLM desligado, valide a calibracao
# do ranking deterministico/embeddings e entao habilite CRM_MATCH_USE_LLM=1.
AI_WORKER_PROCESSES=1
AI_WORKER_THREADS=1
CRM_NOTICE_LIST_CACHE_TTL_SECONDS=60
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
VITE_AI_FEATURES_ENABLED=1

# Monitoramento de e-mail via IMAP (sem Google Cloud)
EMAIL_MONITOR_ENABLED=0
EMAIL_MONITOR_IMAP_HOST=imap.gmail.com
EMAIL_MONITOR_IMAP_PORT=993
EMAIL_MONITOR_USER=monitoramento@seudominio.com
EMAIL_MONITOR_PASSWORD=senha-de-app
EMAIL_MONITOR_MAILBOX=INBOX
EMAIL_MONITOR_ONLY_UNSEEN=1
EMAIL_MONITOR_INTERVAL_SECONDS=300
EMAIL_MONITOR_MAX_MESSAGES=25
