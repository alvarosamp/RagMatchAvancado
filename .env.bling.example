# Bling API v3 (server-side only; never expose these values to the frontend)
# Client ID, Client Secret e tokens são cadastrados pela tela e cifrados por tenant.
BLING_ENABLE_JWT=1
BLING_TIMEOUT_SECONDS=30

# Gere uma vez com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BLING_CREDENTIALS_ENCRYPTION_KEY=

# Cadastre este callback no aplicativo Bling:
# https://SEU_DOMINIO/api/integrations/bling/oauth/callback
BLING_FRONTEND_CALLBACK_URL=/integracoes/bling?bling=connected

# Override only for tests or if Bling changes its official URLs.
BLING_API_URL=https://api.bling.com.br/Api/v3
BLING_OAUTH_URL=https://api.bling.com.br/Api/v3/oauth/token
BLING_AUTHORIZE_URL=https://www.bling.com.br/Api/v3/oauth/authorize
