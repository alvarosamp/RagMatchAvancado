# Supply secrets through deployment environment; never commit real credentials.
MARKET_DATABASE_URL=postgresql://market_runtime:CHANGE_ME@db:5432/ragmatch
MARKET_TENANT_IDS=1
MARKET_WORKER_IMAGE=ragmatch-market-worker:local
MARKET_DBT_ENABLED=false
MARKET_DB_HOST=db
MARKET_DB_PORT=5432
MARKET_DB_NAME=ragmatch
MARKET_DB_USER=market_transform
MARKET_DB_PASSWORD=CHANGE_ME
MARKET_SCHEDULE_SECONDS=3600
MARKET_SCHEDULE_SOURCES=crm,quality
MARKET_MLFLOW_TRACKING_URI=http://mlflow:5000
MARKET_BLING_COMPANY_MAP={"1":"BLING_COMPANY_ID"}
# Optional, only after verifying an index-level series appropriate to category.
MARKET_DEFLATOR_SERIES=
MARKET_DEFLATOR_BASE_MONTH=
# Metabase's own metadata database is separate from the analytical data source.
METABASE_DB_HOST=db
METABASE_DB_NAME=metabase
METABASE_DB_USER=metabase_app
METABASE_DB_PASSWORD=CHANGE_ME
